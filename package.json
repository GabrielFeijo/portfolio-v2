{
  "name": "space-portfolio-v2",
  "version": "2.0.0",
  "private": true,
  "packageManager": "bun@1.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "check": "bun run typecheck && bun run lint && bun run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/src/src-modules-smoke.test.ts tests/src/app.test.tsx tests/src/main.test.tsx",
    "test:e2e": "playwright test",
    "test:budget": "node scripts/check-bundle-budget.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.15.0",
    "framer-motion": "^12.6.3",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.4",
    "three": "0.170.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@react-three/test-renderer": "8.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint__js": "^9.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@types/three": "0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.5"
  }
}
